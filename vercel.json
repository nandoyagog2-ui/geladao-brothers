{
  "headers": [
    {
      "source": "/painel/whats.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' chrome-extension: https://web.whatsapp.com"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/painel/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' chrome-extension: https://web.whatsapp.com"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/painel",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' chrome-extension: https://web.whatsapp.com"
        }
      ]
    },
    {
      "source": "/(js|css|img)/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:loja([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Instagram|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/api/og?loja=:loja"
    },
    {
      "source": "/:loja([a-z0-9-]+)/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Instagram|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/api/og?loja=:loja"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Instagram|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/:loja([a-z0-9-]+)",
      "destination": "/index.html"
    },
    {
      "source": "/:loja([a-z0-9-]+)/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cardapiovyntra.com.br"
        }
      ],
      "destination": "/vyntra/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.cardapiovyntra.com.br"
        }
      ],
      "destination": "/vyntra/",
      "permanent": false
    }
  ]
}